SECRET_KEY=change-this-to-a-random-string

# Database: leave DATABASE_URL unset (and MYSQL_HOST unset) to use a local
# sqlite file with zero setup. Set DATABASE_URL to any SQLAlchemy URI to use
# something else directly, e.g. mysql+pymysql://user:pass@host:3306/dbname
# — or, simpler, just fill in the MYSQL_* vars below and leave DATABASE_URL
# unset; config.py assembles the URI from these for you.
DATABASE_URL=sqlite:///aligned.db
# MYSQL_HOST=localhost
# MYSQL_PORT=3306
# MYSQL_USER=aligned_app
# MYSQL_PASSWORD=
# MYSQL_DATABASE=aligned

# AI provider. OpenRouter is used when OPENROUTER_API_KEY is set (the server
# runs qwen/qwen3.7-plus); otherwise Gemini is used directly.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=qwen/qwen3.7-plus
# Used automatically when the main model is rate-limited or down
OPENROUTER_FALLBACK_MODELS=google/gemini-3.1-flash-lite
# OPENROUTER_REASONING=off
GEMINI_API_KEY=your-google-ai-studio-key
GEMINI_MODEL=gemini-2.5-flash
FRONTEND_ORIGIN=http://127.0.0.1:5500

# "Forgot password?" emails a reset code through Resend (resend.com). The
# sender domain must be verified in Resend.
RESEND_API_KEY=
MAIL_FROM=AlignED <noreply@align-ed.online>
